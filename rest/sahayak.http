# @name AdminUpdateScheme
# @auth bearer {{auth.token}}
PUT {{base.url}}/api/v1/admin/schemes/{{scheme.id}}
Content-Type: application/json
Accept-Language: en

{"name_en": "Test Scheme (updated)"}

