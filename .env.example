# Application
APP_ENV=development
PORT=8080
LOG_LEVEL=debug
SERVER_MODE=all

# Database
DATABASE_URL=postgres://sahayak:sahayak@localhost:5432/sahayak?sslmode=disable
POSTGRES_USER=sahayak
POSTGRES_PASSWORD=sahayak
POSTGRES_DB=sahayak

# Secrets (generate strong random values for production)
JWT_SECRET=dev-insecure-jwt-secret-change-me
PHONE_HASH_PEPPER=dev-insecure-pepper-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Voice (sarvam | bhashini)
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# LLM (gemini | openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SMS (msg91)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER=SAHAYK

# WhatsApp (gupshup)
WHATSAPP_PROVIDER=gupshup
WHATSAPP_API_KEY=

# Storage
DATA_DIR=./data
PDF_DIR=./data/pdfs
FONT_DIR=./fonts
MAX_AUDIO_SECONDS=60
MAX_AUDIO_MB=5
